# Copy to .env and fill in. .env is gitignored.

# --- GenAI (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_REASONING_EFFORT=low

# --- AWS (python -m cloud.setup aws) ---
AWS_PROFILE=jo-cli                     # AWS CLI profile used for S3 + IAM
AWS_REGION=ap-south-1
TRAFFIC_AWS_ACCOUNT_ID=879352492139    # setup refuses to run against any other account
# TRAFFIC_S3_BUCKET=                   # default: bengaluru-traffic-<account>-<region> (written here by setup)

# --- Snowflake (python -m cloud.setup snowflake) ---
SNOWFLAKE_ACCOUNT=                     # e.g. myorg-myaccount (Snowsight > Account > Account identifier)
SNOWFLAKE_ADMIN_USER=                  # a user with ACCOUNTADMIN, used only for provisioning
SNOWFLAKE_ADMIN_PASSWORD=
# SNOWFLAKE_ADMIN_AUTHENTICATOR=username_password_mfa   # Duo push for MFA users (or externalbrowser for SSO)
# SNOWFLAKE_ADMIN_PASSCODE=                             # TOTP code, if your MFA uses one
SNOWFLAKE_MONTHLY_CREDIT_QUOTA=20      # resource monitor suspends the warehouse at this many credits/month
# Object names (defaults shown)
# SNOWFLAKE_DATABASE=TRAFFIC
# SNOWFLAKE_WAREHOUSE=TRAFFIC_WH
# SNOWFLAKE_ROLE=TRAFFIC_ROLE
# SNOWFLAKE_USER=TRAFFIC_SVC
