              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:\\Users\\Jonna\\BengaluruTrafficAnalysis\\output\\powerbi\\fact_traffic_events.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"event_id\", type text}, {\"date_key\", Int64.Type}, {\"road_segment_id\", type text}, {\"weather_key\", type text}, {\"incident_key\", type text}, {\"vehicle_count\", Int64.Type}, {\"avg_speed_kmph\", type number}, {\"occupancy_pct\", type number}, {\"congestion_level\", type text}, {\"incident_duration_minutes\", Int64.Type}}, \"en-US\"),",
                "    Local = Table.TransformColumns(Typed, {{\"event_ts\", each if _ = null or _ = \"\" then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(Text.Replace(_, \" \", \"T\"))), type datetime}})",
                "in",
