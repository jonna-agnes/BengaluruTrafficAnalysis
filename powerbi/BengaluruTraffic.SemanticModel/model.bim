      {
        "name": "fact_traffic_5min",
        "columns": [
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none"
          },
          {
            "name": "road_segment_id",
            "dataType": "string",
            "sourceColumn": "road_segment_id",
            "summarizeBy": "none"
          },
          {
            "name": "window_start",
            "dataType": "dateTime",
            "sourceColumn": "window_start",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn"
          },
          {
            "name": "window_end",
            "dataType": "dateTime",
            "sourceColumn": "window_end",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn"
          },
          {
            "name": "area",
            "dataType": "string",
            "sourceColumn": "area",
            "summarizeBy": "none"
          },
          {
            "name": "road_name",
            "dataType": "string",
            "sourceColumn": "road_name",
            "summarizeBy": "none"
          },
          {
            "name": "total_events",
            "dataType": "int64",
            "sourceColumn": "total_events",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_vehicle_count",
            "dataType": "double",
            "sourceColumn": "avg_vehicle_count",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_speed_kmph",
            "dataType": "double",
            "sourceColumn": "avg_speed_kmph",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_occupancy_pct",
            "dataType": "double",
            "sourceColumn": "avg_occupancy_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "peak_congestion_rank",
            "dataType": "int64",
            "sourceColumn": "peak_congestion_rank",
            "summarizeBy": "none"
          },
          {
            "name": "peak_congestion_level",
            "dataType": "string",
            "sourceColumn": "peak_congestion_level",
            "summarizeBy": "none",
            "sortByColumn": "peak_congestion_rank"
          },
          {
            "type": "calculated",
            "name": "Hour",
            "dataType": "int64",
            "expression": "HOUR ( fact_traffic_5min[window_start] )",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Windows",
            "expression": "COUNTROWS ( fact_traffic_5min )",
            "formatString": "#,0"
          },
          {
            "name": "Total Vehicles",
            "expression": "SUMX ( fact_traffic_5min, fact_traffic_5min[avg_vehicle_count] * fact_traffic_5min[total_events] )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Speed (km/h)",
            "expression": "AVERAGE ( fact_traffic_5min[avg_speed_kmph] )",
            "formatString": "0.00"
          },
          {
            "name": "Avg Occupancy %",
            "expression": "AVERAGE ( fact_traffic_5min[avg_occupancy_pct] )",
            "formatString": "0.00"
          },
          {
            "name": "Avg Congestion Rank",
            "expression": "AVERAGE ( fact_traffic_5min[peak_congestion_rank] )",
            "formatString": "0.00"
          },
          {
            "name": "Severe Windows %",
            "expression": "DIVIDE ( CALCULATE ( [Windows], fact_traffic_5min[peak_congestion_level] = \"Severe\" ), [Windows] )",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "fact_traffic_5min",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:\\Users\\Jonna\\BengaluruTrafficAnalysis\\output\\powerbi\\fact_traffic_5min.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"date_key\", Int64.Type}, {\"road_segment_id\", type text}, {\"area\", type text}, {\"road_name\", type text}, {\"total_events\", Int64.Type}, {\"avg_vehicle_count\", type number}, {\"avg_speed_kmph\", type number}, {\"avg_occupancy_pct\", type number}, {\"peak_congestion_rank\", Int64.Type}, {\"peak_congestion_level\", type text}}, \"en-US\"),",
                "    Local = Table.TransformColumns(Typed, {{\"window_start\", each if _ = null or _ = \"\" then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(Text.Replace(_, \" \", \"T\"))), type datetime}, {\"window_end\", each if _ = null or _ = \"\" then null else DateTimeZone.RemoveZone(DateTimeZone.FromText(Text.Replace(_, \" \", \"T\"))), type datetime}})",
                "in",
                "    Local"
              ]
            }
          }
        ]
