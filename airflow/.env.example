SNOWFLAKE_WAREHOUSE=TRAFFIC_WH
SNOWFLAKE_DATABASE=TRAFFIC
SNOWFLAKE_SCHEMA=RAW

AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
